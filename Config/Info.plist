<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_lancio-jv._tcp</string>
		<string>_lancio-jv._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Per trovare i dispositivi vicini con Lancio aperto e lanciargli foto e link.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.it.discosizer.lancio</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Lancio</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
